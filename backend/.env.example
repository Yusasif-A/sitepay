# SitePay backend configuration. Copy to .env and fill in.
# NEVER commit the filled-in .env.

# ── Database ─────────────────────────────────────────────────────────────────
# mongomock:// = in-memory, zero setup, data lost on restart.
MONGO_URI=mongomock://
MONGO_DB_NAME=sitepay

# ── PayPal (developer.paypal.com/dashboard → Apps & Credentials, Sandbox) ────
# Leave both blank to run payouts in SIMULATED mode (no PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# PAYPAL_MODE=simulate   # force simulation even with credentials set

# Wages are in WAGE_CURRENCY; PayPal pays in PAYOUT_CURRENCY (NGN is not a
# PayPal payout currency). PAYOUT_FX_RATE wage units = 1 payout unit.
WAGE_CURRENCY=NGN
PAYOUT_CURRENCY=USD
PAYOUT_FX_RATE=1500

# Sandbox personal-account email(s) the demo crew is paid to.
DEMO_PAYPAL_RECEIVERS=

# ── AI (any OpenAI-compatible endpoint with a vision model) ──────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_VISION_MODEL=
# Check-in photos stamped after this time are flagged late.
CHECK_IN_LATE_AFTER=08:30

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-string
WHATSAPP_APP_SECRET=
# WHATSAPP_PAYNOTE_TEMPLATE=   # approved template (body {{1}}) for pay notes after 24h
DEFAULT_COUNTRY_CODE=234

# ── Auth / server ────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173
SITE_TIMEZONE=Africa/Lagos
PORT=5001
